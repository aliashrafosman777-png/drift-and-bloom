# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Optional but recommended guard against deploying with the wrong database name.
EXPECTED_MONGODB_DATABASE=driftandbloom
# Optional but recommended Atlas cluster hostname, without credentials or protocol.
EXPECTED_MONGODB_HOST=cluster.example.mongodb.net

# Safe, non-secret label returned in API headers to detect environment drift.
# Use distinct values such as local, preview, and production.
DATA_SOURCE_ID=local

# JWT secret — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Resend API key for email OTP authentication
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Drift & Bloom <noreply@yourdomain.com>

# Site URL (used in email templates)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
